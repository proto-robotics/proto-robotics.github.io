{
    "name": "code.protorobotics.org",
    "description": "Block and line coding interface for PROTO Robotics",
    "license": "MIT",
    "author": "Carston Wiebe <ctwiebe23@gmail.com>",
    "scripts": {
        "build": "webpack",
        "format": "npx prettier ./src/*.js -w",
        "start": "webpack serve",
        "app:icons": "node scripts/make-app-icons.mjs && capacitor-assets generate --android --ios --assetPath resources",
        "app:sync": "npm run build && cap sync android",
        "app:apk": "npm run app:sync && cd android && gradlew assembleDebug",
        "app:java": "python scripts/vscode-java.py",
        "app:ios": "npm run build && cap sync ios && cap open ios"
    },
    "dependencies": {
        "@blockly/continuous-toolbox": "^7.0.9",
        "@blockly/field-colour-hsv-sliders": "^6.0.5",
        "@blockly/field-grid-dropdown": "^6.0.10",
        "@blockly/plugin-scroll-options": "^7.0.9",
        "@blockly/shadow-block-converter": "^7.0.10",
        "@blockly/toolbox-search": "^3.1.9",
        "@blockly/workspace-backpack": "^7.0.11",
        "@blockly/workspace-minimap": "^0.3.9",
        "@blockly/zoom-to-fit": "^7.0.9",
        "@capacitor/android": "^8.5.2",
        "@capacitor/cli": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "@capacitor/ios": "^8.5.2",
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.10.4",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/language": "^6.12.4",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/search": "^6.7.1",
        "@codemirror/state": "^6.7.0",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.43.4",
        "@mit-app-inventor/blockly-plugin-workspace-multiselect": "file:vendor/blockly-plugin-workspace-multiselect-1.0.2-blockly12-f26447c-patch1.tgz",
        "@protorobotics/jenga": "1.3.0",
        "blockly": "^12.5.1",
        "codemirror": "^6.0.2",
        "ellipsi": "^3.2.2",
        "jszip": "^3.10.1",
        "marked": "^16.4.0",
        "pyodide": "^0.28.3",
        "svg-path-editor-lib": "^1.0.3",
        "thememirror": "^2.0.1"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "baseline-browser-mapping": "^2.9.19",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.5",
        "html-webpack-plugin": "^5.6.8",
        "mini-css-extract-plugin": "^2.10.2",
        "prettier": "^3.6.2",
        "vite": "^7.3.1",
        "webpack": "^5.102.1",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.6"
    },
    "prettier": {
        "trailingComma": "all",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true
    },
    "version": "1.0.0",
    "main": "bundled.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/proto-robotics/proto-robotics.github.io.git"
    },
    "keywords": [],
